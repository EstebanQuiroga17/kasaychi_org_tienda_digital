---
import Layout from '../layouts/Layout.astro';
import CheckoutFlow from '../components/store/CheckoutFlow.tsx';
import { ArrowLeft, ShieldCheck } from 'lucide-react';
---

<Layout
  title="Finalizar Compra (Checkout) | Tienda Kasaychi"
  description="Completa tus datos de envío y sube el comprobante de transferencia bancaria para confirmar tu pedido en la Tienda Comunitaria Kasaychi."
>
  <!-- Cabecera del Checkout -->
  <section class="pt-32 pb-12 bg-institutional-blue text-white relative overflow-hidden">
    <div class="absolute inset-0 chacana-bg opacity-5 pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-8 relative z-10">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <a
          href="/tienda/"
          class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-ancestral-gold hover:text-white transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          Volver al Catálogo de la Tienda
        </a>
        <span class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-white/80">
          <ShieldCheck className="w-4 h-4 text-ancestral-gold" />
          Pago directo por Transferencia Bancaria
        </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-bold leading-tight">
        Finalizar <span class="text-ancestral-gold">Pedido Comunitario</span>
      </h1>
      <p class="text-white/85 font-serif mt-2 max-w-2xl text-base md:text-lg">
        Ingresa tus datos de entrega, realiza la transferencia a la cuenta de la Comunidad Kasaychi y adjunta la captura o PDF de tu comprobante.
      </p>
    </div>
  </section>

  <!-- Flujo Interactivo de Checkout (Isla React) -->
  <section class="py-12 md:py-16 bg-paper min-h-[60vh]">
    <div class="max-w-7xl mx-auto px-8">
      <CheckoutFlow client:load />
    </div>
  </section>
</Layout>

